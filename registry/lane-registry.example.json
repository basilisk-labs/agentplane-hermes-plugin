{
  "schema": "agentplane.hermes.lane-registry.v2",
  "lanes": [
    {
      "name": "agentplane-coder",
      "match": "agentplane-*",
      "kind": "agentplane",
      "spawn": {
        "command": "hermes",
        "args": [
          "agentplane",
          "supervise",
          "--task-id",
          "{agentplane_task_id}",
          "--root",
          "{repo}"
        ]
      },
      "env": [
        "HERMES_KANBAN_TASK",
        "HERMES_KANBAN_BOARD",
        "HERMES_KANBAN_RUN_ID",
        "HERMES_KANBAN_WORKSPACE",
        "HERMES_KANBAN_CLAIM_LOCK"
      ]
    }
  ]
}
